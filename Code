#include <msp430.h>
#include <stdint.h>

// ==================== Pins ====================

#define SDA BIT2
#define SCL BIT3

#define SDA_HIGH  P1OUT |= SDA
#define SDA_LOW   P1OUT &= ~SDA
#define SCL_HIGH  P1OUT |= SCL
#define SCL_LOW   P1OUT &= ~SCL
#define SDA_IN    P1DIR &= ~SDA
#define SDA_OUT   P1DIR |= SDA
#define SDA_READ  (P1IN & SDA)

// ==================== I2C Adressen ====================

#define OLED_ADDR    0x3C
#define TMP1075_ADDR 0x48
#define FDC1004_ADDR 0x50
#define OPT3001_ADDR 0x44

// ==================== Kalibrierung ====================

#define CAP_DRY   -4500
#define CAP_WET   -1
#define RH_DRY    25
#define RH_WET    85
#define AVG_SAMPLES 8

// ==================== Grenzwerte ====================

#define TEMP_MIN  15
#define TEMP_MAX  30
#define HUM_MIN   30
#define HUM_MAX   70
#define LUX_MIN   300

