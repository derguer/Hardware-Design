// ==================== I2C Funktionen ====================

void delay_i2c(void) {
    __delay_cycles(50);
}

void i2c_start(void) {
    SDA_OUT;
    SDA_HIGH;
    SCL_HIGH;
    delay_i2c();
    SDA_LOW;
    delay_i2c();
    SCL_LOW;
}

void i2c_stop(void) {
    SDA_OUT;
    SDA_LOW;
    delay_i2c();
    SCL_HIGH;
    delay_i2c();
    SDA_HIGH;
    delay_i2c();
}

void i2c_write_byte(uint8_t data) {
    uint8_t i;
    SDA_OUT;
    
    for (i = 0; i < 8; i++) {
        if (data & 0x80) {
            SDA_HIGH;
        } else {
            SDA_LOW;
        }
        delay_i2c();
        SCL_HIGH;
        delay_i2c();
        SCL_LOW;
        data <<= 1;
    }
    
    SDA_IN;
    delay_i2c();
    SCL_HIGH;
    delay_i2c();
    SCL_LOW;
    SDA_OUT;
}

uint8_t i2c_read_byte(uint8_t ack) {
    uint8_t i, data = 0;
    
    SDA_IN;
    
    for (i = 0; i < 8; i++) {
        data <<= 1;
        SCL_HIGH;
        delay_i2c();
        if (SDA_READ) {
            data |= 1;
        }
        SCL_LOW;
        delay_i2c();
    }
    
    SDA_OUT;
    if (ack) {
        SDA_LOW;
    } else {
        SDA_HIGH;
    }
    delay_i2c();
    SCL_HIGH;
    delay_i2c();
    SCL_LOW;
    SDA_LOW;
    
    return data;
}

// ==================== OLED Funktionen ====================

void oled_cmd(uint8_t cmd) {
    i2c_start();
    i2c_write_byte(OLED_ADDR << 1);
    i2c_write_byte(0x00);
    i2c_write_byte(cmd);
    i2c_stop();
}

void oled_data(uint8_t data) {
    i2c_start();
    i2c_write_byte(OLED_ADDR << 1);
    i2c_write_byte(0x40);
    i2c_write_byte(data);
    i2c_stop();
}

