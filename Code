#define OPT3001_REG_CONFIG   0x01
#define OPT3001_REG_MANU_ID  0x7E
#define OPT3001_REG_DEV_ID   0x7F

// ==================== Kalibrierung Feuchtigkeit ====================

#define CAP_DRY   -4558
#define CAP_WET   -1
#define RH_DRY    25
#define RH_WET    85

