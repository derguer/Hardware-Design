// ==================== I2C ====================

void i2c_start(void) {
    SDA_OUT; SDA_HIGH; SCL_HIGH;
    __delay_cycles(50);
    SDA_LOW; __delay_cycles(50); SCL_LOW;
}

void i2c_stop(void) {
    SDA_OUT; SDA_LOW; __delay_cycles(50);
    SCL_HIGH; __delay_cycles(50); SDA_HIGH;
}

void i2c_write(uint8_t d) {
    uint8_t i;
    SDA_OUT;
    for (i = 0; i < 8; i++) {
        if (d & 0x80) SDA_HIGH; else SDA_LOW;
        __delay_cycles(50); SCL_HIGH;
        __delay_cycles(50); SCL_LOW;
        d <<= 1;
    }
    SDA_IN; __delay_cycles(50);
    SCL_HIGH; __delay_cycles(50); SCL_LOW; SDA_OUT;
}

uint8_t i2c_read(uint8_t ack) {
    uint8_t i, d = 0;
    SDA_IN;
    for (i = 0; i < 8; i++) {
        d <<= 1; SCL_HIGH; __delay_cycles(50);
        if (SDA_READ) d |= 1;
        SCL_LOW; __delay_cycles(50);
    }
    SDA_OUT;
    if (ack) SDA_LOW; else SDA_HIGH;
    __delay_cycles(50); SCL_HIGH;
    __delay_cycles(50); SCL_LOW; SDA_LOW;
    return d;
}

// ==================== OLED ====================

void oled_cmd(uint8_t c) {
    i2c_start();
    i2c_write(OLED_ADDR << 1);
    i2c_write(0x00);
    i2c_write(c);
    i2c_stop();
}

void oled_data(uint8_t d) {
    i2c_start();
    i2c_write(OLED_ADDR << 1);
    i2c_write(0x40);
    i2c_write(d);
    i2c_stop();
}

void oled_init(void) {
    __delay_cycles(100000);
    oled_cmd(0xAE);
    oled_cmd(0xD5); oled_cmd(0x80);
    oled_cmd(0xA8); oled_cmd(0x3F);
    oled_cmd(0xD3); oled_cmd(0x00);
    oled_cmd(0x40);
    oled_cmd(0x8D); oled_cmd(0x14);
    oled_cmd(0x20); oled_cmd(0x00);
    oled_cmd(0xA1); oled_cmd(0xC8);
    oled_cmd(0xDA); oled_cmd(0x12);
    oled_cmd(0x81); oled_cmd(0xFF);
    oled_cmd(0xD9); oled_cmd(0xF1);
    oled_cmd(0xDB); oled_cmd(0x40);
    oled_cmd(0xA4); oled_cmd(0xA6);
    oled_cmd(0xAF);
}

void oled_clear(void) {
    uint16_t i;
    oled_cmd(0x21); oled_cmd(0); oled_cmd(127);
    oled_cmd(0x22); oled_cmd(0); oled_cmd(7);
    for (i = 0; i < 1024; i++) oled_data(0x00);
}

void oled_pos(uint8_t x, uint8_t p) {
    oled_cmd(0x21); oled_cmd(x); oled_cmd(127);
    oled_cmd(0x22); oled_cmd(p); oled_cmd(7);
}

void oled_char(char c) {
    uint8_t i, idx;
    if (c >= 'a' && c <= 'z') c -= 32;
    if (c < 32 || c > 90) idx = 0;
    else idx = c - 32;
    for (i = 0; i < 5; i++) oled_data(font[idx][i]);
    oled_data(0x00);
}

void oled_str(const char *s) {
    while (*s) oled_char(*s++);
}

void oled_int(int32_t v) {
    char b[8];
    int8_t i = 0;
    uint8_t n = 0;
    if (v < 0) { n = 1; v = -v; }
    if (v == 0) { oled_char('0'); return; }
    while (v > 0) { b[i++] = '0' + (v % 10); v /= 10; }
    if (n) oled_char('-');
    while (i > 0) oled_char(b[--i]);
}

void oled_bar(uint8_t x, uint8_t p, uint8_t w, uint8_t pct) {
    uint8_t i;
    uint8_t filled = (uint8_t)(((uint16_t)(w - 2) * pct) / 100);
    oled_pos(x, p);
    oled_data(0x7F);
    for (i = 0; i < w - 2; i++) {
        if (i < filled) oled_data(0x7F);
        else oled_data(0x55);
    }
    oled_data(0x7F);
}

void oled_ok(uint8_t x, uint8_t p) {
    oled_pos(x, p);
    oled_data(0x00);
    oled_data(0x10);
    oled_data(0x20);
    oled_data(0x40);
    oled_data(0x20);
    oled_data(0x10);
    oled_data(0x08);
    oled_data(0x04);
}

void oled_bad(uint8_t x, uint8_t p) {
    oled_pos(x, p);
    oled_data(0x00);
    oled_data(0x63);
    oled_data(0x36);
    oled_data(0x1C);
    oled_data(0x1C);
    oled_data(0x36);
    oled_data(0x63);
    oled_data(0x00);
}

// 3 Punkte Animation
void oled_dots(uint8_t x, uint8_t p, uint8_t count) {
    uint8_t i;
    oled_pos(x, p);
    for (i = 0; i < 3; i++) {
        if (i < count) {
            oled_data(0x00);
            oled_data(0x3C);
            oled_data(0x7E);
            oled_data(0x7E);
            oled_data(0x3C);
            oled_data(0x00);
            oled_data(0x00);
        } else {
            oled_data(0x00);
            oled_data(0x00);
            oled_data(0x00);
            oled_data(0x00);
            oled_data(0x00);
            oled_data(0x00);
            oled_data(0x00);
        }
    }
}

// ==================== Sensoren ====================

int16_t read_temp(void) {
    uint8_t m, l;
    int16_t r;
    i2c_start(); i2c_write(TMP1075_ADDR << 1); i2c_write(0x00); i2c_stop();
    __delay_cycles(5000);
    i2c_start(); i2c_write((TMP1075_ADDR << 1) | 1);
    m = i2c_read(1); l = i2c_read(0); i2c_stop();
    r = ((int16_t)m << 4) | (l >> 4);
    if (r & 0x800) r |= 0xF000;
    return (int16_t)(((int32_t)r * 625) / 100);
}

void fdc_wreg(uint8_t r, uint16_t v) {
    i2c_start(); i2c_write(FDC1004_ADDR << 1);
    i2c_write(r); i2c_write(v >> 8); i2c_write(v & 0xFF);
    i2c_stop(); __delay_cycles(5000);
}

uint16_t fdc_rreg(uint8_t r) {
    uint8_t m, l;
    i2c_start(); i2c_write(FDC1004_ADDR << 1); i2c_write(r); i2c_stop();
    __delay_cycles(5000);
    i2c_start(); i2c_write((FDC1004_ADDR << 1) | 1);
    m = i2c_read(1); l = i2c_read(0); i2c_stop();
    return ((uint16_t)m << 8) | l;
}

void fdc_init(void) {
    fdc_wreg(0x0C, 0x8000);
    __delay_cycles(100000);
    fdc_wreg(0x08, 0x1C00);
}

int32_t read_cap(void) {
    uint16_t m, l, c;
    int32_t r;
    uint16_t t = 500;
    fdc_wreg(0x0C, 0x0480);
    do { __delay_cycles(20000); c = fdc_rreg(0x0C); t--; }
    while (!(c & 0x0008) && t > 0);
    if (t == 0) return -9999;
    m = fdc_rreg(0x00); l = fdc_rreg(0x01);
    r = ((int32_t)m << 8) | (l >> 8);
    if (r & 0x800000) r |= 0xFF000000;
    return r / 524;
}

void opt_wreg(uint8_t r, uint16_t v) {
    i2c_start(); i2c_write(OPT3001_ADDR << 1);
    i2c_write(r); i2c_write(v >> 8); i2c_write(v & 0xFF);
    i2c_stop(); __delay_cycles(5000);
}

uint16_t opt_rreg(uint8_t r) {
    uint8_t m, l;
    i2c_start(); i2c_write(OPT3001_ADDR << 1); i2c_write(r); i2c_stop();
    __delay_cycles(5000);
    i2c_start(); i2c_write((OPT3001_ADDR << 1) | 1);
    m = i2c_read(1); l = i2c_read(0); i2c_stop();
    return ((uint16_t)m << 8) | l;
}

void opt_init(void) {
    opt_wreg(0x01, 0xC410);
    __delay_cycles(150000);
}

int32_t read_lux(void) {
    uint16_t r = opt_rreg(0x00);
    return (int32_t)(r & 0x0FFF) << ((r >> 12) & 0x0F);
}

int16_t cap_to_hum(int32_t c) {
    int32_t h = RH_DRY + ((c - CAP_DRY) * (RH_WET - RH_DRY)) / (CAP_WET - CAP_DRY);
    if (h < 0) h = 0;
    if (h > 100) h = 100;
    return (int16_t)h;
}

// ==================== Main ====================

int main(void) {
    int16_t temp, hum;
    int32_t cap, lux;
    int16_t tc, lv;
    int32_t cs = 0;
    uint8_t cc = 0;
    int32_t ca = -4500;
    uint8_t hr = 0, i, dot;
    
    WDTCTL = WDTPW | WDTHOLD;
    P1SEL0 &= ~(SDA | SCL);
    P1SEL1 &= ~(SDA | SCL);
    P1DIR |= SDA | SCL;
    P1OUT |= SDA | SCL;
    PM5CTL0 &= ~LOCKLPM5;
    
    __delay_cycles(500000);
    oled_init();
    oled_clear();
    
    // ========== STARTUP ==========
    
    oled_pos(10, 2);
    oled_str("PLANT SENSOR");
    
    oled_pos(28, 5);
    oled_str("STARTING");
    
    // 3 Punkte Animation
    dot = 0;
    for (i = 0; i < 18; i++) {
        oled_dots(80, 5, dot + 1);
        dot = (dot + 1) % 3;
        
        if (i == 5) fdc_init();
        if (i == 10) opt_init();
        
        __delay_cycles(200000);
    }
    
    // Calibrating
    oled_pos(28, 5);
    oled_str("CALIBRATE");
    
    dot = 0;
    for (i = 0; i < 12; i++) {
        oled_dots(82, 5, dot + 1);
        dot = (dot + 1) % 3;
        
        cap = read_cap();
        if (cap != -9999) { cs += cap; cc++; }
        
        __delay_cycles(150000);
    }
    if (cc > 0) { ca = cs / cc; hr = 1; }
    cs = 0; cc = 0;
    
    // Ready
    oled_pos(28, 5);
    oled_str("   READY!    ");
    __delay_cycles(800000);
    
    oled_clear();
    
    // ========== MAIN LOOP ==========
    
    while (1) {
        temp = read_temp();
        cap = read_cap();
        lux = read_lux();
        
        if (cap != -9999) {
            cs += cap;
            cc++;
            if (cc >= AVG_SAMPLES) {
                ca = cs / AVG_SAMPLES;
                cs = 0; cc = 0; hr = 1;
            }
        }
        hum = cap_to_hum(ca);
        tc = temp / 100;
        lv = lux / 100;
        
        // ===== TEMPERATURE (Page 0) =====
        oled_pos(0, 0);
        oled_str("TEMP     ");
        oled_int(tc);
        oled_char('.');
        oled_int((temp < 0 ? -temp : temp) % 100 / 10);
        oled_str(" C   ");
        if (tc >= TEMP_MIN && tc <= TEMP_MAX) oled_ok(118, 0);
        else oled_bad(118, 0);
        
        // ===== HUMIDITY (Page 2, Bar auf Page 4) =====
        oled_pos(0, 2);
        oled_str("HUMIDITY ");
        if (hr) {
            oled_int(hum);
            oled_str(" %   ");
        } else {
            oled_str("---   ");
        }
        if (hr && hum >= HUM_MIN && hum <= HUM_MAX) oled_ok(118, 2);
        else if (hr) oled_bad(118, 2);
        
        if (hr) oled_bar(0, 3, 110, hum);
        
        // ===== LIGHT (Page 5, Bar auf Page 7) =====
        oled_pos(0, 5);
        oled_str("LIGHT    ");
        oled_int(lv);
        oled_str(" LX   ");
        if (lv >= LUX_MIN) oled_ok(118, 5);
        else oled_bad(118, 5);
        
        oled_bar(0, 6, 110, (lv > 10000 ? 100 : lv / 100));
        __delay_cycles(300000);
    }
}
