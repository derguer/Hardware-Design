    oled_cmd(x);
    oled_cmd(127);
    oled_cmd(0x22);
    oled_cmd(page);
    oled_cmd(7);
}

void oled_putchar(char c) {
    uint8_t i, idx;
    
    if (c < 32 || c > 122) {
        idx = 0;
    } else {
        idx = c - 32;
    }
    
    for (i = 0; i < 5; i++) {
        oled_data(font[idx][i]);
    }
    oled_data(0x00);
}

void oled_print(const char *str) {
    while (*str) {
        oled_putchar(*str++);
    }
}

void oled_print_int(int32_t val) {
    char buf[12];
    int8_t i = 0;
    uint8_t neg = 0;
    
    if (val < 0) {
        neg = 1;
        val = -val;
    }
    
    if (val == 0) {
        oled_putchar('0');
        return;
    }
    
    while (val > 0) {
        buf[i++] = '0' + (val % 10);
        val /= 10;
    }
    
    if (neg) {
        oled_putchar('-');
    }
    
    while (i > 0) {
        oled_putchar(buf[--i]);
    }
}

void oled_print_temp(int16_t temp_x100) {
    int16_t whole, frac;
    
    if (temp_x100 < 0) {
        oled_putchar('-');
        temp_x100 = -temp_x100;
    }
    
    whole = temp_x100 / 100;
    frac = temp_x100 % 100;
    
    oled_print_int(whole);
    oled_putchar('.');
    if (frac < 10) {
        oled_putchar('0');
    }
    oled_print_int(frac);
}

void oled_print_hex(uint16_t val) {
    char hex[] = "0123456789ABCDEF";
    oled_putchar('0');
    oled_putchar('x');
    oled_putchar(hex[(val >> 12) & 0xF]);
    oled_putchar(hex[(val >> 8) & 0xF]);
    oled_putchar(hex[(val >> 4) & 0xF]);
    oled_putchar(hex[val & 0xF]);
}

// ==================== TMP1075 Funktionen ====================

int16_t tmp1075_read_temp(void) {
    uint8_t msb, lsb;
    int16_t raw_temp;
    int32_t temp_x100;
    
    i2c_start();
    i2c_write_byte(TMP1075_ADDR << 1);
    i2c_write_byte(0x00);
    i2c_stop();
    
    __delay_cycles(5000);
    
    i2c_start();
    i2c_write_byte((TMP1075_ADDR << 1) | 1);
    msb = i2c_read_byte(1);
    lsb = i2c_read_byte(0);
    i2c_stop();
    
    raw_temp = ((int16_t)msb << 4) | (lsb >> 4);
    
    if (raw_temp & 0x800) {
        raw_temp |= 0xF000;
    }
    
    temp_x100 = ((int32_t)raw_temp * 625) / 100;
    
    return (int16_t)temp_x100;
}

// ==================== FDC1004 Funktionen ====================

void fdc1004_write_reg(uint8_t reg, uint16_t value) {
    i2c_start();
    i2c_write_byte(FDC1004_ADDR << 1);
    i2c_write_byte(reg);
    i2c_write_byte(value >> 8);
    i2c_write_byte(value & 0xFF);
    i2c_stop();
    __delay_cycles(5000);
}

uint16_t fdc1004_read_reg(uint8_t reg) {
    uint8_t msb, lsb;
    
    i2c_start();
    i2c_write_byte(FDC1004_ADDR << 1);
    i2c_write_byte(reg);
    i2c_stop();
    
    __delay_cycles(5000);
    
    i2c_start();
    i2c_write_byte((FDC1004_ADDR << 1) | 1);
    msb = i2c_read_byte(1);
    lsb = i2c_read_byte(0);
    i2c_stop();
    
    return ((uint16_t)msb << 8) | lsb;
}

uint16_t fdc1004_read_id(void) {
    return fdc1004_read_reg(0xFF);
}

void fdc1004_init(void) {
    fdc1004_write_reg(0x0C, 0x8000);
    __delay_cycles(100000);
    fdc1004_write_reg(0x08, 0x1C00);
}

int32_t fdc1004_read_capacitance(void) {
    uint16_t meas_msb, meas_lsb;
    uint16_t fdc_conf;
    int32_t raw;
    uint16_t timeout;
    
    fdc1004_write_reg(0x0C, 0x0480);
    
    timeout = 500;
    do {
        __delay_cycles(20000);
        fdc_conf = fdc1004_read_reg(0x0C);
        timeout--;
    } while (!(fdc_conf & 0x0008) && (timeout > 0));
    
    if (timeout == 0) {
        return -9999;
    }
    
    meas_msb = fdc1004_read_reg(0x00);
    meas_lsb = fdc1004_read_reg(0x01);
    
    raw = ((int32_t)meas_msb << 8) | (meas_lsb >> 8);
    
    if (raw & 0x800000) {
        raw |= 0xFF000000;
    }
    
    return raw / 524;
}

// ==================== OPT3001 Funktionen ====================

void opt3001_write_reg(uint8_t reg, uint16_t value) {
    i2c_start();
    i2c_write_byte(OPT3001_ADDR << 1);
    i2c_write_byte(reg);
    i2c_write_byte(value >> 8);
    i2c_write_byte(value & 0xFF);
    i2c_stop();
    __delay_cycles(5000);
}

uint16_t opt3001_read_reg(uint8_t reg) {
    uint8_t msb, lsb;
    
    i2c_start();
    i2c_write_byte(OPT3001_ADDR << 1);
    i2c_write_byte(reg);
    i2c_stop();
    
    __delay_cycles(5000);
    
    i2c_start();
    i2c_write_byte((OPT3001_ADDR << 1) | 1);
    msb = i2c_read_byte(1);
    lsb = i2c_read_byte(0);
    i2c_stop();
    
    return ((uint16_t)msb << 8) | lsb;
}

uint16_t opt3001_read_device_id(void) {
    return opt3001_read_reg(OPT3001_REG_DEV_ID);
}

uint16_t opt3001_read_manufacturer_id(void) {
    return opt3001_read_reg(OPT3001_REG_MANU_ID);
}

void opt3001_init(void) {
    // Config: Auto-range, 100ms, continuous mode
    // 0xC410 = Auto-scale, 100ms conversion, continuous
    opt3001_write_reg(OPT3001_REG_CONFIG, 0xC410);
    __delay_cycles(150000);
}

int32_t opt3001_read_lux(void) {
    uint16_t raw;
    uint16_t mantissa;
    uint8_t exponent;
    int32_t lux_x100;
    
    raw = opt3001_read_reg(OPT3001_REG_RESULT);
    
    // Bits 15:12 = Exponent, Bits 11:0 = Mantissa
    // Lux = 0.01 * 2^E * R
    exponent = (raw >> 12) & 0x0F;
    mantissa = raw & 0x0FFF;
    
    lux_x100 = (int32_t)mantissa << exponent;
    
    return lux_x100;
}

// ==================== Feuchtigkeit ====================

int16_t cap_to_humidity(int32_t cap_pf) {
    int32_t humidity;
    
    humidity = RH_DRY + ((cap_pf - CAP_DRY) * (RH_WET - RH_DRY)) / (CAP_WET - CAP_DRY);
    
    if (humidity < 0) humidity = 0;
    if (humidity > 100) humidity = 100;
    
    return (int16_t)humidity;
}

// ==================== Main ====================

int main(void) {
    int16_t temperature;
    int32_t capacitance;
    int16_t humidity;
    int32_t lux;
    uint16_t fdc_id, opt_id;
    int32_t cap_sum = 0;
    uint8_t cap_count = 0;
    int32_t cap_avg = 0;
    
    WDTCTL = WDTPW | WDTHOLD;
    
    P1SEL0 &= ~(SDA | SCL);
    P1SEL1 &= ~(SDA | SCL);
    P1DIR |= SDA | SCL;
    P1OUT |= SDA | SCL;
    
    PM5CTL0 &= ~LOCKLPM5;
    
    __delay_cycles(500000);
    
    oled_init();
    oled_clear();
    
    // ===== Sensor Check =====
    oled_set_cursor(0, 0);
    oled_print("Sensor Check");
    
    oled_set_cursor(0, 2);
    oled_print("FDC: ");
    fdc_id = fdc1004_read_id();
    oled_print_hex(fdc_id);
    oled_print(fdc_id == 0x1004 ? " OK" : " ERR");
    
    oled_set_cursor(0, 4);
    oled_print("OPT: ");
    opt_id = opt3001_read_device_id();
    oled_print_hex(opt_id);
    oled_print(opt_id == 0x3001 ? " OK" : " ERR");
    
    __delay_cycles(3000000);
    
    fdc1004_init();
    opt3001_init();
    
    oled_clear();
    
    // ===== Hauptschleife =====
    while (1) {
        temperature = tmp1075_read_temp();
        capacitance = fdc1004_read_capacitance();
        lux = opt3001_read_lux();
        
        if (capacitance != -9999) {
            cap_sum += capacitance;
            cap_count++;
            if (cap_count >= AVG_SAMPLES) {
                cap_avg = cap_sum / AVG_SAMPLES;
                cap_sum = 0;
                cap_count = 0;
            }
        }
        humidity = cap_to_humidity(cap_avg);
        
        // Zeile 0: Temperatur
        oled_set_cursor(0, 0);
        oled_print("Temp: ");
        oled_print_temp(temperature);
        oled_print(" C    ");
        
        // Zeile 2: Feuchtigkeit
        oled_set_cursor(0, 2);
        oled_print("Hum:  ");
        oled_print_int(humidity);
        oled_print(" %    ");
        
        // Zeile 4: Licht (Lux)
        oled_set_cursor(0, 4);
        oled_print("Lux:  ");
        oled_print_int(lux / 100);
        oled_putchar('.');
        if ((lux % 100) < 10) oled_putchar('0');
        oled_print_int(lux % 100);
        oled_print("      ");
        
        // Zeile 6: Kapazität (Debug)
        oled_set_cursor(0, 6);
        oled_print("Cap: ");
        oled_print_int(cap_avg);
        oled_print(" pF    ");
        
        __delay_cycles(200000);
    }
}
